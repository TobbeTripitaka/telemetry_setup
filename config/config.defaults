# Literal key=value data. No shell expansion, inline comments or commands.
# Install locally as /etc/tele/config.txt; choose a unique station label.
station=station01
EXECUTE=auto
HARVEST_MODE=incremental
MAINTENANCE_IDLE_SECONDS=600
HARVEST_BUDGET_SECONDS=3600
NETWORK_TIMEOUT_SECONDS=300
RETAIN_LAST_BATCH=yes
MIN_FREE_MIB=2048
OVERLAP_DAYS=2
