[Unit]
Description=TELE field collection (powers off on exit, including failure)
Requires=tele-power-guard.timer
After=local-fs.target tele-power-guard.timer
ConditionPathExists=/etc/tele/FIELD_ENABLED

[Service]
Type=exec
User=root
UMask=0077
Environment=TELE_FIELD_SERVICE=1
ExecStart=/opt/tele/current/tele.sh --field
# Powers off only while field mode is armed, so `tele-maintenance on` can keep the computer
# on even in the middle of a run (it removes the marker file).
ExecStopPost=/bin/sh -c 'if [ -e /etc/tele/FIELD_ENABLED ]; then exec /usr/bin/systemctl --no-block poweroff; fi'
KillMode=control-group
TimeoutStopSec=20s
Restart=no
# Independent timer is primary. RuntimeMaxSec is a second bound on this service.
RuntimeMaxSec=4h

[Install]
WantedBy=multi-user.target
